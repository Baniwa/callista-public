# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env

DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Gemini AI (Google) — obtenha sua chave em https://aistudio.google.com/app/apikey
# Tier gratuito: 1500 requisições/dia com gemini-2.0-flash
GEMINI_API_KEY=your-gemini-api-key-here

# Banco de dados (padrão: SQLite para desenvolvimento)
DATABASE_URL=sqlite:///db.sqlite3

# API do Senado Federal (dados abertos — sem autenticação)
SENADO_API_BASE_URL=https://legis.senado.leg.br/dadosabertos

# Código interno de acesso ao cadastro de novos funcionários SEPEL.
# O gestor define e distribui este valor pessoalmente para cada novo membro.
# Troque após cada ciclo de contratação.
CALLISTA_CODIGO_SETOR=defina-um-codigo-secreto-aqui